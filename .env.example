# Shared secrets between the web and hermes containers. Copy to .env and fill in.
# Generate tokens with: openssl rand -hex 32
CONTROL_TOKEN=change-me-random-64
CRM_INGEST_TOKEN=change-me-random-64
# Neon Postgres connection string (Console -> Project -> Connect).
# The whole team points at the same Neon project; use a Neon branch for
# experiments you don't want in shared data.
NEON_CONNECTION_STRING=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
