{
  "name": "video",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render DishaVideo out/disha-buddy.mp4",
    "normalize": "ffmpeg -y -i out/disha-buddy.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -ar 48000 -ac 2 -c:a aac -b:a 192k -movflags +faststart out/disha-buddy-final.mp4",
    "build": "npm run render && npm run normalize",
    "build:audio": "node build-audio.mjs",
    "build:voiced": "node build-voiced.mjs",
    "typecheck": "tsc --noEmit",
    "prep:clips": "node prep-clips.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@remotion/cli": "^4.0.498",
    "@remotion/google-fonts": "^4.0.498",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.498"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
